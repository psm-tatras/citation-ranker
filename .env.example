# S3 settings for model adapters and corpus data
S3_BUCKET=
# S3_KEY_PREFIX takes priority; AWS_MODEL_DIRECTORY is the fallback used by
# training/train_qlora.py (and prediction/predict_ner.py) to save/load the
# model adapter. Keep this separate from AWS_DIRECTORY below, which is the
# citation corpus index prefix used by utils/seku_crd_corpus_utils.py.
S3_KEY_PREFIX=ner-model/qwen-ner/
AWS_MODEL_DIRECTORY=ner-model/qwen-ner/
# Separate S3 root for narrative-model runs (training/train_qlora_narrative.py),
# so NER and narrative adapters never share a root prefix.
S3_KEY_PREFIX_NARRATIVE=
AWS_NARRATIVE_MODEL_DIRECTORY=narrative_model/
AWS_BUCKET_NAME=
AWS_DIRECTORY=
AWS_REGION=us-east-1

# Optional explicit credentials. Prefer an IAM role or the AWS credential chain.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# W&B settings
WANDB_PROJECT=my-ner-project
WANDB_DATASET_ARTIFACT=dataset-ner-3k:latest
# WANDB_ADAPTER_ARTIFACT_NAME is shared by train_qlora.py (NER); leave unset to
# use its default 'qwen-ner-adapter'. Narrative has its own separate var below
# so the two adapters never collide under the same W&B artifact name.
WANDB_NARRATIVE_ADAPTER_ARTIFACT_NAME=qwen-narrative-adapter